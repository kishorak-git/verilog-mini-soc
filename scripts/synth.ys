read_verilog rtl/mini_soc.v rtl/ram.v rtl/gpio.v rtl/timer.v rtl/uart.v rtl/spi.v
hierarchy -check -top mini_soc
synth -top mini_soc
flatten
opt
tee -o simulation/synthesis/mini_soc_stats.txt stat
write_json simulation/synthesis/mini_soc.json

design -reset
read_verilog rtl/ram.v
hierarchy -check -top ram
synth -top ram
flatten
opt
tee -o simulation/synthesis/ram_stats.txt stat

design -reset
read_verilog rtl/gpio.v
hierarchy -check -top gpio
synth -top gpio
flatten
opt
tee -o simulation/synthesis/gpio_stats.txt stat

design -reset
read_verilog rtl/timer.v
hierarchy -check -top timer
synth -top timer
flatten
opt
tee -o simulation/synthesis/timer_stats.txt stat

design -reset
read_verilog rtl/uart.v
hierarchy -check -top uart_bus
synth -top uart_bus
flatten
opt
tee -o simulation/synthesis/uart_stats.txt stat

design -reset
read_verilog rtl/spi.v
hierarchy -check -top spi_bus
synth -top spi_bus
flatten
opt
tee -o simulation/synthesis/spi_stats.txt stat
